# GEMINI_API_KEY: Required for server-side Gemini AI content analysis, generation, and audio transcription.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DEFAULT_GEMINI_MODEL: Configurable default Gemini model for content intelligence and asset generation.
DEFAULT_GEMINI_MODEL="gemini-3.8-flash"

# TRANSCRIPTION_GEMINI_MODEL: Configurable Gemini model for audio/video transcription.
TRANSCRIPTION_GEMINI_MODEL="gemini-3.5-transcribe"

# FFMPEG_PATH: Path to FFmpeg binary for video clip extraction, aspect-ratio conversion, and subtitle burn-in.
FFMPEG_PATH="/usr/bin/ffmpeg"

# MAX_UPLOAD_SIZE_MB: Maximum allowed source media upload size in megabytes.
MAX_UPLOAD_SIZE_MB="250"

# MAX_RENDER_CONCURRENCY: Maximum concurrent FFmpeg video rendering jobs.
MAX_RENDER_CONCURRENCY="2"

# STORAGE_DIR: Local persistence directory for project records, uploaded sources, rendered clips, and exports.
STORAGE_DIR="./storage"
